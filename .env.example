# =============================================================================
# NEXA — Environment Configuration
# =============================================================================

# --- Server Configuration ---
NEXA_HOST=0.0.0.0
NEXA_PORT=8000
NEXA_LOG_LEVEL=INFO

# --- LLM Provider ---
# Options: local_rules (Zero-Key Offline), ollama (Local LLM), openai, anthropic, gemini
LLM_PROVIDER=local_rules

# --- OpenAI (Optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Anthropic (Optional) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Ollama (Optional Local Free LLM) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Security ---
MEDIUM_RISK_POLICY=ask
AUDIT_LOGGING=true
MAX_AGENT_ITERATIONS=20

# --- Memory ---
MEMORY_FILE=nexa_memory.json
